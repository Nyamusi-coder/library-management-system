{
  "name": "library-management-system",
  "version": "1.0.0",
  "description": "Library management system data layer",
  "scripts": {
    "prisma:generate": "prisma generate --schema api/prisma/schema.prisma",
    "db:migrate": "dotenv -e api/.env -- prisma migrate dev --schema api/prisma/schema.prisma",
    "db:seed": "dotenv -e api/.env -- prisma db seed --schema api/prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit",
    "postinstall": "prisma generate --schema api/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx api/prisma/seed.ts"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/mapped-types": "^12.0.1",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/passport-jwt": "^4.0.1",
    "dotenv-cli": "^8.0.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
