{
  "name": "library-management-system",
  "version": "1.0.0",
  "description": "Library management system data layer",
  "scripts": {
    "prisma:generate": "prisma generate --schema api/prisma/schema.prisma",
    "db:migrate": "dotenv -e api/.env -- prisma migrate dev --schema api/prisma/schema.prisma",
    "db:seed": "dotenv -e api/.env -- prisma db seed --schema api/prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit",
    "postinstall": "prisma generate --schema api/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx api/prisma/seed.ts"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv-cli": "^8.0.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
